  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fbfe8f2e323ed8043a085246c602841c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  description: "Vous recevez un courrier de la part d\u2019un usager.\r\n\r\nLa tombe
    \xE0 c\xF4t\xE9 de la mienne est une vieille tombe compl\xE8tement abandonn\xE9e,
    envahie par la v\xE9g\xE9tation. J\u2019ai peur que le lierre ne d\xE9borde,
    et je suis s\xFBr d\u2019avoir vu un renardeau un soir. Je ne veux pas de salet\xE9s.
    Enlevez-l\xE0 !\r\n\r\nVous avez en effet le droit de reprendre une tombe \xE0
    l\u2019abandon et de laisser quelqu\u2019un installer une nouvelle tombe \xE0
    la place. De nombreuses personnes seront contentes d\u2019avoir une place dans
    cette partie du cimeti\xE8re. En m\xEAme temps, les tombes anciennes accueillent
    des esp\xE8ces uniques, et ajoutent un certain charme. \r"
  answerA: "Nettoyer l\u2019emplacement"
  AListHide: []
  AListShow: []
  AarchitecturalPoints: 1
  AlandscapedPoints: 1
  AecologicalPoints: 0
  answerB: Laisser le monument
