  m_Script: {fileID: 11500000, guid: 30bf3ef40443f764799a68701545f9dc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  cemetery: {fileID: 2091481346}
  descriptionUI: {fileID: 13249329}
  buttonATextUI: {fileID: 659045834}
  buttonBTextUI: {fileID: 559824079}
  buttonAUI: {fileID: 635926532}
  buttonBUI: {fileID: 1713759670}
  requestsParent: {fileID: 1872298299}
  depedenciesParent: {fileID: 333055261}
  waitingTimeBetweenElements: 0.5
  waitingTimeBetweenHideShow: 0.5
  fadeDuration: 2
  architecturalEndingDescription: "Vous avez con\xE7u un cimeti\xE8re architectural
    ! \r\n\r\nLes cimeti\xE8res architecturaux privil\xE9gient la pierre et un paysage
    d\xE9gag\xE9. Ils sont souvent d\xE9crits comme \u201Cpropres\u201D, ce qui veut
    dire sans faune et sans flore spontan\xE9e. La majorit\xE9 des cimeti\xE8res
    en France sont des cimeti\xE8res architecturaux.\r\r"
  landscapedEndingDescription: "Vous avez con\xE7u un cimeti\xE8re paysager ! \r\n\r\nLes
    cimeti\xE8res paysagers int\xE8grent la pr\xE9sence de plantes \xE0 des fins
    d\xE9coratives. Ils conservent un paysage d\xE9gag\xE9 mais pr\xE9sentent plus
    d\u2019arbres et d\u2019herbe. Les cimeti\xE8res paysagers se d\xE9veloppent
    \xE0 la fin du XXe si\xE8cle, pour faire revenir de la verdure dans des cimeti\xE8res
    jug\xE9s trop gris.\r\r"
  ecologicalEndingDescription: "Vous avez con\xE7u un cimeti\xE8re \xE9cologique
    ! \r\n\r\nLes cimeti\xE8res \xE9cologiques sont une invention r\xE9cente. Leur
    objectif est de conjuguer protection de l\u2019environnement et respect des d\xE9funts.
    Un exemple connu est celui du cimeti\xE8re de Souch\xE9, \xE0 Niort.\r\r"
  hybridEndingDescription: "Vous avez con\xE7u un cimeti\xE8re hybride ! \r\n\r\nChaque
    cimeti\xE8re est unique. Le v\xF4tre int\xE8gre des \xE9l\xE9ments de diff\xE9rents
    mod\xE8les, \xE0 la fois architectural et paysager, paysager et \xE9cologique.
    Gouverner, c\u2019est choisir !\r\r"
  buttonReloadTextUI: {fileID: 1728838923}
  buttonMenuTextUI: {fileID: 310013917}
  buttonReloadUI: {fileID: 1413238137}
