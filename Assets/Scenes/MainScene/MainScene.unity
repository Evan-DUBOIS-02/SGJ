--- !u!114 &1989698631
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1989698629}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fbfe8f2e323ed8043a085246c602841c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  description: "Un matin, le jardinier du cimeti\xE8re vient vous voir\u2026 \r\n\r\n\"\xC9coutez,
    on a un petit souci\u2026 Les all\xE9es en gravier sont envahies par les herbes
    folles. Depuis qu\u2019on n\u2018a plus le droit d\u2019utiliser des pesticides
    sur la commune, c\u2019est compliqu\xE9 de tout entretenir. Et le gravier, \xE7a
    ab\xEEme la tondeuse.\r\n\r\nSi on laissait l\u2019herbe pousser, \xE7a serait
    plus facile pour que je tonde de temps en temps. Et \xE7a serait mieux pour les
    insectes. En m\xEAme temps, \xE7a risque d\u2019\xEAtre plus compliqu\xE9 pour
    les corbillards et pour les gens en fauteuil roulant. Ils pr\xE9f\xE9reront sans
    doute qu\u2019on refasse des all\xE9es. \r\n\r\nQu\u2019est-ce qu\u2019on fait
    ?\"\r"
  answerA: "R\xE9nover les all\xE9es"
  AListHide:
  - {fileID: 78816505}
  - {fileID: 978287450}
  - {fileID: 494751849}
  - {fileID: 971342740}
  AListShow:
  - {fileID: 641270873}
  AarchitecturalPoints: 2
  AlandscapedPoints: 0
  AecologicalPoints: 0
  AudioClipHideA: {fileID: 8300000, guid: 7a42d08b1a44b434381e56765a38b0e2, type: 3}
  AudioClipShowA: {fileID: 8300000, guid: 874c89c1441dc114d9e99f4c0fcc30b1, type: 3}
  answerB: "Laisser l\u2019herbe pousser"
  BListHide:
  - {fileID: 971342740}
  BListShow:
